{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Development",
      "description": "Local development build: debug info, dev tools and mock camera enabled, no packaging.",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ASTRO_BUILD_TESTS": "ON",
        "ASTRO_ENABLE_DEVTOOLS": "ON",
        "ASTRO_ENABLE_MOCK_CAMERA": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Optimized build with development-only tooling disabled.",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ASTRO_BUILD_TESTS": "ON",
        "ASTRO_ENABLE_DEVTOOLS": "OFF",
        "ASTRO_ENABLE_MOCK_CAMERA": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev", "configuration": "Debug" },
    { "name": "release", "configurePreset": "release", "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
