{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Development",
      "description": "Local development build: debug info, dev tools and mock camera enabled, no packaging.",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ASTRO_BUILD_TESTS": "ON",
        "ASTRO_ENABLE_DEVTOOLS": "ON",
        "ASTRO_ENABLE_MOCK_CAMERA": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Optimized build with development-only tooling disabled.",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ASTRO_BUILD_TESTS": "ON",
        "ASTRO_ENABLE_DEVTOOLS": "OFF",
        "ASTRO_ENABLE_MOCK_CAMERA": "ON"
      }
    },
    {
      "name": "release-linux",
      "inherits": "release",
      "displayName": "Release (Linux / Mint)",
      "description": "Linux x86-64 distribution build with CPU processing and camera drivers.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release-linux",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": { "ASTRO_ENABLE_METAL": "OFF" }
    },
    {
      "name": "ci-macos",
      "displayName": "CI (macOS)",
      "description": "Hardware-independent build/test job for the macOS CI runner.",
      "binaryDir": "${sourceDir}/build/ci-macos",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ASTRO_BUILD_TESTS": "ON",
        "ASTRO_ENABLE_DEVTOOLS": "ON",
        "ASTRO_ENABLE_MOCK_CAMERA": "ON"
      }
    },
    {
      "name": "ci-windows",
      "displayName": "CI (Windows)",
      "description": "Hardware-independent build/test job for the Windows CI runner.",
      "binaryDir": "${sourceDir}/build/ci-windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ASTRO_BUILD_TESTS": "ON",
        "ASTRO_ENABLE_DEVTOOLS": "ON",
        "ASTRO_ENABLE_MOCK_CAMERA": "ON"
      }
    },
    {
      "name": "ci-linux",
      "displayName": "CI (Linux)",
      "description": "Hardware-independent build/test job for the Linux CI runner.",
      "binaryDir": "${sourceDir}/build/ci-linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ASTRO_BUILD_TESTS": "ON",
        "ASTRO_ENABLE_DEVTOOLS": "ON",
        "ASTRO_ENABLE_MOCK_CAMERA": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev", "configuration": "Debug" },
    { "name": "release", "configurePreset": "release", "configuration": "Release" },
    { "name": "release-linux", "configurePreset": "release-linux", "configuration": "Release" },
    { "name": "ci-macos", "configurePreset": "ci-macos", "configuration": "Debug" },
    { "name": "ci-windows", "configurePreset": "ci-windows", "configuration": "Debug" },
    { "name": "ci-linux", "configurePreset": "ci-linux", "configuration": "Debug" }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release-linux",
      "configurePreset": "release-linux",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "ci-macos",
      "configurePreset": "ci-macos",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "ci-windows",
      "configurePreset": "ci-windows",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "ci-linux",
      "configurePreset": "ci-linux",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
