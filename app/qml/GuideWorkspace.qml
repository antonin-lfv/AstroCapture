import "Atelier.js" as Atelier
import QtQuick
import QtQuick.Controls.Basic
import QtQuick.Layouts

Rectangle {
    id: root
    color: Atelier.canvas
    property bool captureActive: false
    property int topic: 0
    signal navigate(string tab)
    readonly property var lessons: [

        { title: qsTr("Start here"), lead: qsTr("One observation, three steps"),
          intro: qsTr("Capture a video, combine its sharpest frames, then finish the image. For the Moon, Sun and planets, this gives you more useful material than a single snapshot."),
          cards: [
            {title: qsTr("1 · Capture in SER"), body: qsTr("Focus carefully, keep exposures short and avoid clipping the bright areas. Record a SER video. Atmospheric turbulence changes from frame to frame; a video gives you a choice of sharper moments.")},
            {title: qsTr("2 · Analyze, select, stack"), body: qsTr("Open the SER in Processing. Analyze ranks the frames by sharpness. Start by retaining 25–50%, then compare results. Align and stack combines the selected information into one image.")},
            {title: qsTr("3 · Finish and export"), body: qsTr("Increase wavelets gradually, adjust color and compare before / after. Export a 16-bit PNG or TIFF. Keep the original SER so you can try a different selection later.")},
            {title: qsTr("Observing the Sun"), body: qsTr("Use a solar filter designed for your telescope and observation method before pointing at the Sun. Software and exposure settings do not provide eye or equipment protection.")}
          ], action: qsTr("Go to Capture"), tab: "capture" },
        { title: qsTr("File formats"), lead: qsTr("Choose a format for each stage"),
          intro: qsTr("A video contains many frames. A finished image contains the result of your work. Keep both when you want to be able to start again."),
          cards: [
            {title: qsTr("SER · the recording"), body: qsTr("An uncompressed astronomy video. Use it for capture, sharpness analysis and stacking. AstroCapture opens SER directly; it also opens ACRAW sequences, but does not import AVI.")},
            {title: qsTr("PNG / TIFF · an image to adjust"), body: qsTr("Open a PNG or TIFF directly in Processing, or drop it there. Wavelets, color, comparison and captions are available immediately. There is no frame selection or stacking for a single image. Imports accept single-image files up to 128 MP and 32,700 pixels per dimension, within the memory budget; transparency is placed on black.")},
            {title: qsTr("PNG / TIFF 16-bit · the finished result"), body: qsTr("Processing and Deep sky export 16-bit RGB PNG or TIFF without lossy compression. JPEG is an 8-bit compressed sharing format: keep a PNG, TIFF or linear FITS as your master. Mosaic exports TIFF, or transfers its result to Processing for other formats. A 16-bit file cannot restore information absent from an 8-bit original. JPEG is not a direct Processing input.")},
            {title: qsTr("A snapshot in Capture"), body: qsTr("The photo button saves a PNG preview, a 16-bit TIFF or a raw sensor FITS according to the Capture setting. FITS opens in Deep sky. Record SER for planetary stacking or a FITS sequence for deep-sky exposures.")}
          ], action: qsTr("Go to Processing"), tab: "processing" },
        { title: qsTr("Processing"), lead: qsTr("Read the controls, judge the image"),
          intro: qsTr("For a video, select and stack first. For a PNG, TIFF or transferred mosaic, start directly with detail and color adjustments."),
          cards: [
            {title: qsTr("The quality graph"), body: qsTr("Frames are sorted from sharpest to softest, not by time. The best frame is shown at 100%. Move the blue boundary to change how many are retained. A smaller selection favors sharpness; more frames can reduce noise. The score is a guide, not a guarantee.")},
            {title: qsTr("Moon / Sun and turbulence"), body: qsTr("Choose Moon / Sun for local alignment. Start with 96 px areas; use 64 px for fine contrasted detail or 160 px for softer, noisier surfaces. Best frames per area can use different frames for each region. It takes longer and cannot restore detail missing from every frame.")},
            {title: qsTr("Wavelet levels"), body: qsTr("Levels 1–3 affect finer details; levels 4–6 affect broader structures. Start gently with levels 1 and 2, and watch for noise or bright halos. Maximum gains are 50, 20, 20, 10, 10 and 10. These values are specific to AstroCapture.")},
            {title: qsTr("Before, after and playback"), body: qsTr("Hold Before or use Compare to judge your adjustments. In video mode, Play always shows the original recording, not the stack. An image or mosaic has no video playback. Export saves the finished result.")}
          ], action: qsTr("Go to Processing"), tab: "processing" },
        { title: qsTr("Deep sky"), lead: qsTr("From individual exposures to faint detail"),
          intro: qsTr("Use the Deep sky workspace for FITS or Bayer RAW sequences. The source samples remain linear. Color preview debayers Bayer sensor data; Auto display stretch only changes their visibility. Disable these options to inspect the raw mosaic or linear brightness. Calibration always reads the original file."),
          cards: [
            {title: qsTr("Images and calibration"), body: qsTr("Choose the image type and Add files, or Import folder for a folder and its subfolders. Auto detects roles from metadata and names; verify and edit each role and filter in the image list. Add lights, darks, flats and dark flats for raw data. Raw mode is the default. Enable Lights already calibrated only for preprocessed files, such as calibrated iTelescope FITS. In the Siril tutorial, import Offsets_3s as Dark flats, not Bias. Keep the originals.")},
            {title: qsTr("Reusable calibration masters"), body: qsTr("Open Master library from Images or Stack. Create dark, bias, dark-flat or flat masters from selected source frames, or import existing masters with verified metadata. Three or more frames use robust rejection. Flats are calibrated and normalized when created. A master dark already includes its bias; an imported normalized flat is not calibrated twice. Compare camera, size, Bayer pattern, binning, gain, offset, temperature, exposure and filter before use. Known mismatches block selection; missing metadata requires review. Already calibrated iTelescope lights do not need another calibration. Removing a library entry keeps its FITS for existing projects.")},
            {title: qsTr("Create calibration masters in batches"), body: qsTr("In Master library, choose Create masters in batches. Review the groups made from selected raw FITS or native RAW calibration files. Recorded camera, dimensions, channels, Bayer pattern, binning, gain, offset, temperature, exposure and input normalization units must be equal; flat filters remain separate. Unknown metadata is kept distinct and needs explicit review. Choose which groups to save and an optional name prefix. For each flat, select a matching dark-flat or bias; a unique dark-flat is proposed first, but ambiguity requires your choice. Compatible library masters are available directly, without applying them to lights. Raw correction groups can be used without saving a separate master. Pedestal is subtracted once and each flat is normalized before robust averaging. Groups run sequentially, with MAD rejection from three sources onward and no multi-frame noise reduction from one source. The temporary folder and memory budget are checked; full images support up to 128 MP and 32,700 pixels per dimension, within the memory budget. SHA-256 checks source changes and records source/correction provenance. Each completed master is published atomically; cancellation or the first failure stops the batch and reports unfinished groups, while completed entries remain. Creation does not change the image result or apply masters: return to Find a master, search name/camera/filter/settings, optionally hide known mismatches, inspect diagnostics, then explicitly use a compatible master. Heterogeneous light configurations still require separate integrations; this batch tool creates calibration masters, not a complete automated light/HDR pipeline.")},
            {title: qsTr("Stack settings"), body: qsTr("Inspect star counts, FWHM and source previews; uncheck poor frames and choose a reference per filter. Normalization and rejection are configurable in Advanced stack settings. Start Create the stacked image from Stack settings after checking calibration, reference and advanced options. It runs calibration, alignment, normalization and integration together. Finish and export becomes available when a result exists. Hover parameter labels for help.")},
            {title: qsTr("Resources and temporary files"), body: qsTr("Before stacking, review the memory estimate, safety budget, required temporary disk space and available space. Estimates use all selected lights on the full grid before cropping. Rejection reads bounded horizontal/vertical tiles: at most 64 MiB of float sample buffers, even with 500 exposures. Drizzle projection also accumulates in strips of at most 64 MiB. Outputs support up to 128 MP and 32,700 pixels per dimension. Scientific results and ordinary projection remain full images in memory. Metal finishing uses strips; CPU and advanced operations can require complete intermediates. Finishing checks the combined options and retained results before computation; an oversized request keeps the previous result. FITS and TIFF encode bounded blocks without a complete planar/file copy. WCS/SIP drizzle scans source rows for each strip to preserve curved footprints and can take longer. The memory model includes retained Deep sky images and native buffers, not an exact process measurement or other applications; budget is half physical RAM, capped at 8 GiB, with 2 GiB fallback. Disk uses 12 bytes per output pixel per exposure in ordinary stacking, 16 in mono/RGB drizzle and 24 in native Bayer, plus 256 MiB reserve. Filter groups run sequentially, so temporary projections are released between groups. Choose Temporary folder for a larger writable local disk; the preference stays on this computer, outside the project. Space is checked again by the engine; write or read failures stop the whole operation and keep the previous result. Private working files are removed on success, error and cancellation. Working data uses one anonymous or deleted-on-close archive per job; the operating system releases its contents if the process terminates. Automatic recovery remains limited to 4 GiB and 64 image references; disable maps or split filter groups when the planned results exceed these limits.")},
            {title: qsTr("Drizzle: when it can help"), body: qsTr("In Stack → Advanced stack settings, enable Drizzle. Mono / RGB projects calibrated pixel footprints with their stellar alignment; Bayer inputs are debayered in this standard mode. For undersampled mono / RGB data with varied subpixel shifts, try ×2 and pixel fraction 0.8. ×2 creates four times as many pixels, without guaranteeing finer detail. Review dimensions and contributor counts; the output supports up to 128 MP and 32,700 pixels per dimension, subject to memory and recovery budgets. A 26 MP source at ×2 is about 104 MP. Maps and multiple filter groups can exceed the budgets; review Resources before stacking. Compare with ordinary stacking.")},
            {title: qsTr("Native Bayer drizzle"), body: qsTr("Enable Native Bayer / CFA only for single-channel sources that retain the sensor mosaic. Each calibrated pixel contributes only to its measured color; the color copy used for registration never supplies interpolated export pixels. Start at ×1 with pixel fraction 1, and use many poses with varied dither positions. Coverage and robust rejection are checked separately in R, G and B. Identical poses leave missing colors and stop stacking; the previous result is kept. Temporary projections use 24 bytes per output pixel per exposure, compared with 16 in mono / RGB. Leave Bayer pattern from metadata selected when the pattern is known. If a FITS only says VALID, explicitly select its verified stored-image pattern, including offsets and row order. The declaration also applies to selected single-channel calibrations and is saved in the project. Conflicting known patterns block stacking. Already debayered RGB data cannot use native Bayer.")},
            {title: qsTr("WCS / SIP: optical distortion during stacking"), body: qsTr("In Stack → Advanced stack settings, enable WCS / SIP distortion projection only when each input FITS has a valid TAN or TAN-SIP solution for its stored pixels. Coordinates from a cropped, flipped or debayered image must describe that exact image. Solving the final stack alone is insufficient. The software compares relative stellar positions: at least 12 matches in four of nine regions, spanning 35% of each image dimension, and RMS at most 0.75 pixel of the original reference. Wrong or missing coordinates reject that source; there is no affine fallback, and at least two validated lights per group must remain. All sources, including the reference, are projected onto its TAN plane without SIP. Ordinary stacking uses bilinear sampling; drizzle uses adaptive curved pixel footprints (0.001 output-pixel subdivision tolerance), with separate measured Bayer colors if enabled. Borders are cropped to common coverage and unmeasured Bayer channels remain explicit. Float32 values retain the source intensity convention, not an absolute flux or pixel-area photometry calibration. Source WCS consistency does not prove absolute sky coordinates: solve the result against a catalogue before PCC/SPCC. Review each source's star count and RMS in the stack report. Disabled by default; existing projects keep their previous behavior.")},
            {title: qsTr("Weight and rejection maps"), body: qsTr("In Stack → Advanced stack settings, enable Keep weight and rejection maps before stacking. The optional RGB Float32 maps sum retained geometrical weights, count retained contributors, and count combined low/high rejected samples. They add about 36 bytes per output pixel per group to memory and projects. Inspect each color independently, especially with native Bayer. The preview scales zero to black and the maximum to white; it is reduced and is not a noise or confidence measure. Export maps as full-resolution floating-point FITS with the stack WCS, without stretch or caption. Existing projects without maps still open normally; stack again to create diagnostics.")},
            {title: qsTr("Linear HDR: preserve bright cores"), body: qsTr("In Stack, choose Merge different exposures · HDR. Select 2–8 calibrated linear FITS lights in one filter group, ideally one mean stack per exposure duration. Calibrate each series separately with matching masters before merging; debayer CFA sources. Verify individual sub-exposure durations: EXPTIME in exported stacks can be total integration time. Verify identical camera, filter, gain, offset, binning and sample units; missing metadata is not proof. Set each input's measured saturation threshold: floating-point FITS has no universal clipping value. HDR aligns stars, scales by duration and combines with shared RGB weights proportional to exposure and a smooth saturation transition. Six star matches are required and residuals above one pixel block fusion. Unrecovered pixels retain the shortest available clipped sample and are marked in a map; no detail is invented. Output remains linear in the longest individual exposure's units and can exceed 1. Total integration time is unknown. Finish before classic export. The two binary HDR maps, settings, input paths and alignment report are saved in projects.")},
            {title: qsTr("Source or stacked result?"), body: qsTr("The image label tells you whether you are viewing a source or the stacked result. Clicking a file name previews that source without replacing the export result. Use Show stacked result to return. Stacking primarily improves noise; finishing reveals faint detail.")},
            {title: qsTr("Histogram and manual stretch"), body: qsTr("In Finish and export, the linear histogram shows data with the current color gains and the stretch curve. Select Black, Midtones or White, then drag in the graph, or edit numeric levels and the midtones slider. Zoom only changes the graph view. Watch the sampled clipping estimates; moving white can clip bright stars. Asinh offers a different stretch that preserves color ratios.")},
            {title: qsTr("Live preview and before / after"), body: qsTr("Adjustments update automatically. Before, Result and Split compare the stack before finishing with the current result; Before is displayed without stretch. The comparison follows rotations and mirrors. To compare a source exposure, open the folder button beside Comparison and hold Raw exposure. Exports use the finished stack.")},
            {title: qsTr("Finishing adjustments"), body: qsTr("Open Stretch, Background, Color, Geometry, Advanced transformations, or Stars and background. Each family opens and closes independently, including in smaller windows; several may stay open and all may be closed. Changes apply automatically. Delete these adjustments resets the selected family. Cmd+Z restores previous settings. The project gear contains presets for the entire finish. Projects preserve all finishing settings.")},
            {title: qsTr("Multifilter composition"), body: qsTr("In Finishing → Color, choose RGB, LRGB, HOO or SHO to assign integrated filters automatically. Missing or ambiguous filters are listed and prevent composition. Custom keeps manual channel assignment. Luminance contribution blends RGB brightness at 0% with aligned L brightness at 100%; it does not equalize exposure units or restore saturated detail. Click Compose image after changing the choices: until then, the previous composition remains displayed. Choices are saved in projects and recovery. Resolve WCS again for the composed image; PCC/SPCC applies to broadband RGB, not representative HOO/SHO palettes.")},
            {title: qsTr("Color, background and export"), body: qsTr("Combine filters as RGB, LRGB, SHO or HOO. Start with gradient correction, then verify WCS and calibrate colors on the linear image before stretching. Gradient extraction fits each color channel with a polynomial of degree 1 to 4; edit the sky samples and inspect the model so that real nebulosity is not removed. Initial automatic color gains only estimate a neutral background. After stretch, SCNR offers four green-protection methods and optional CIE lightness preservation. Inspect at 100% and compare. Linear FITS preserves the original 32-bit integration. Classic export saves the finished image as PNG, TIFF or JPEG with an optional caption.")},
            {title: qsTr("GHS: controlled contrast"), body: qsTr("Enable GHS in Advanced transformations; it enables stretch and replaces midtones/asinh. Start with low strength, place SP near the intensity of interest, then adjust local intensity b. LP ≤ SP ≤ HP controls tangent extensions for shadows and highlights. The curve shows normalized input versus output; gray is identity. Independent RGB and shared-luminance RGB blending have different color behavior. Inverse reverses the scalar curve, not clipping, masks or color blending. Adjust the strength gradually.")},
            {title: qsTr("PSF and restoration"), body: qsTr("Work on an unstretched, unrotated recipe input. Measure central stars, review the FWHM and scatter, then explicitly use the Gaussian estimate; Moffat beta remains manual. PSF preview is display-scaled, while its linear kernel sums to 1. Richardson-Lucy restores weighted luminance with a shared RGB factor. Start with 10 iterations, damping 0.001 and stopping 0.0001 in normalized image units. Compare at 100%; rings and amplified noise mean the correction is too strong. Negative input is rejected. An explicit pedestal is available and remains in the result. It is residual-damped restoration, not blind or spatially varying deconvolution.")},
            {title: qsTr("Denoising and masks"), body: qsTr("Multiscale denoising uses B3-spline à trous wavelets and per-scale MAD soft thresholds. Start with 3 scales, threshold 3, and luminance/chroma strengths 0.5. Prefer it before stretch and restoration. Advanced transformations offers automatic luminance, radial and detected-star masks, plus painted and imported masks. White applies treatment, black protects, gray blends; red previews protected areas. Choose all finishing adjustments, denoising only, deconvolution only, or stretch/color only. Imported masks must match the recipe input size. In the painting editor, Cmd+Z removes a stroke and Apply confirms the mask. Automatic masks regenerate from each operation input; painted/imported masks and their settings are saved with the project.")},
            {title: qsTr("Astrometry and catalog colors"), body: qsTr("Open Color → Astrometry · PCC / SPCC. Guided solving uses approximate ICRS RA/Dec in degrees and sampling in arcsec/pixel, pre-filled from FITS when available. Blind solving uses local Astrometry.net indexes without a starting position: install index 4109 for wide fields or choose suitable indexes. No image is uploaded. Check independent Gaia matches, RMS and field coverage. SIP orders 2–5 model optical distortion; start at 3 and increase only with sufficient reference stars. Gaia may be online or supplied as a local CSV. Verified WCS follows crop, rotation, mirroring and resize, and is saved in floating-point FITS and projects.")},
            {title: qsTr("PCC or SPCC: calibrate before stretch"), body: qsTr("PCC estimates broadband colors with Gaia stellar temperature models. SPCC integrates measured Gaia XP spectra through your measured RGB photon response (sensor QE × filters). Import wavelength_nm,red,green,blue CSV data with increasing wavelengths within 336–1020 nm and zero response at both endpoints. Choose Sun CALSPEC or constant Fν as the neutral white. At least eight accepted stars are needed; saturated, edge, weak and inconsistent stars are rejected. Review gains, rejected stars and residual scatter. Calibration is bound to the exact linear input; changed data requires recalibration. Narrowband SHO/HOO palettes are artistic mappings, not natural RGB colors.")},
            {title: qsTr("Target names, equipment profiles and sky coordinates"), body: qsTr("In Astrometry, enter a catalogue name such as M42 or NGC 7000 and choose Search. CDS Sesame returns approximate J2000 coordinates; only the target name is sent. This fills the centre hint without replacing a verified WCS or changing the pixels. Set the sampling and solve to verify the image. Equipment profiles stores your imported measured RGB responses with camera, filters, source and notes. Use profile copies the curve into the project; run PCC/SPCC separately to recalibrate. Import/export library creates a local JSON backup. No manufacturer curve is inferred automatically. After a verified WCS, hover over the result to read ICRS RA in hours and Dec in degrees. The copy icon keeps the last image position and copies both sexagesimal and decimal coordinates. Crop, mirrors, rotation, resize and before/after comparison use the same sky position. Precision is limited by the WCS fit; source, mask and background-model previews have no readout.")},
            {title: qsTr("Local photometric references"), body: qsTr("Use linear broadband RGB and a CSV with header x,y,red,green,blue. Supply at least three already-matched stars, zero-based pixel coordinates from the top left, and positive reference fluxes for the intended filters. This does not identify stars or download a catalogue. Aperture photometry subtracts local annulus medians; saturated, edge and inconsistent references are rejected. Median log color ratios produce R/B gains relative to green. Inspect the accepted count, gains and residual scatter. Aperture/annulus defaults are 5/8/12 pixels and saturation 1; adapt them to your stars and data scale. This is relative color calibration, not absolute or spectrophotometric calibration. References are image-specific even when saved in a preset.")},
            {title: qsTr("Stars and background: controlled separation"), body: qsTr("Enable separation in the Stars and background family on a linear recipe input, after gradient and color calibration and before stretch. Fit Gaussian or Moffat stellar profiles; inspect accepted/rejected counts and the residual background. Crowded, saturated or poorly fitted stars stay in the background: this is PSF subtraction, not complete star removal. A neutral setting reproduces the combined image. Adjust stellar brightness, saturation and midtones separately from background brightness, saturation and smoothing. Both layers share the main stretch. Inspect Combined, Stars and Background at 100%. Export each calculated layer as signed 32-bit FITS with the current geometry/WCS; their sum reconstructs the combined result. Main exports always save the combined image.")},
            {title: qsTr("Presets and undo"), body: qsTr("Finishing presets in the project gear save or restore all finishing families. Use Cmd+Z to undo. Export offers Linear FITS for the original integration and Classic export for PNG, TIFF or JPEG with an optional caption. PNG and TIFF preserve 16-bit detail without lossy compression.")},
            {title: qsTr("Apple Silicon acceleration"), body: qsTr("Large images use automatic GPU acceleration for stretch, color, smoothing and wavelets. Smaller images and unsupported operations keep the CPU. Original data and export precision stay unchanged. No extra setting is required.")},
            {title: qsTr("Capture and projects"), body: qsTr("In Capture, choose Deep sky · FITS sequence, set exposure and frame count, and start. Raw sensor samples and acquisition metadata are saved in individual FITS. Mount tracking and guiding remain external. The project gear opens and saves projects. Portable includes sources, masks and floating-point results in one file. Linked saves paths and settings; recreate the stack after reopening. Find moved sources searches a new folder and verifies matching content.")}
          ], action: qsTr("Go to Deep sky"), tab: "deepSky" },
        { title: qsTr("Judge your result"), lead: qsTr("Reveal detail while preserving the image"),
          intro: qsTr("There is no universal ideal setting. Judge the whole image, then inspect it at 100%. The histogram and comparisons help you spot lost information and processing artifacts."),
          cards: [
            {title: qsTr("Background and faint detail"), body: qsTr("Keep smooth transitions and faint structures. Some fine noise is acceptable. A completely black background can hide nebulosity; heavy smoothing can erase detail or create a plastic appearance. A real nebula may extend across the field: do not force the entire background to be uniform.")},
            {title: qsTr("Highlights and histogram"), body: qsTr("Watch the clipping estimates as you adjust black and white. Avoid removing faint data or turning bright stars and object cores into featureless white areas. The histogram shape depends on the object and framing; there is no universal target shape. Detail already saturated during capture cannot be recovered by lowering brightness.")},
            {title: qsTr("Sharpness and color"), body: qsTr("Increase wavelets gradually. At 100%, check for amplified grain, bright or dark halos, rings and doubled edges around stars, planets and craters. Check that saturation preserves color differences. RGB and narrowband palettes have different goals: SHO or HOO colors do not need to resemble natural RGB colors.")},
            {title: qsTr("A practical comparison"), body: qsTr("Change one control at a time. Compare with a less processed version at similar brightness. Inspect a faint area, a bright area and a detailed area at 100%, then return to the whole image. Reduce the last adjustment slightly: if artifacts disappear while useful detail remains, keep the gentler setting. The deep-sky raw comparison uses independent stretching and original framing; it is a visual reference, not a numerical noise measurement.")},
            {title: qsTr("More contrast is not more signal"), body: qsTr("Stacking can improve signal-to-noise ratio. Stretching makes existing signal visible, and sharpening can amplify both detail and noise. No single sharpness score proves that a finished image is good. Keep the originals and the linear FITS so you can revisit your choices.")}
          ], action: qsTr("Go to Processing"), tab: "processing" },
        { title: qsTr("Mosaics"), lead: qsTr("Build a wider view of the Moon or Sun"),
          intro: qsTr("Photograph overlapping portions using the same setup and a consistent exposure. Aim for 25–40% overlap, with recognizable details shared between neighboring views."),
          cards: [
            {title: qsTr("Prepare each portion"), body: qsTr("For best results, record one SER per portion and stack each one. Export the portions as TIFF without captions and with similar, moderate sharpening. Add these TIFFs to Mosaic; PNG and JPEG also work.")},
            {title: qsTr("Select and assemble"), body: qsTr("Use the checkboxes to include or leave out images. Automatic exclusion retains the largest connected group and leaves other views visible, unchecked. At least two compatible views are needed. A smooth solar edge alone may not provide enough distinctive detail.")},
            {title: qsTr("Brightness and edges"), body: qsTr("Assembly options can balance exposure and soften the outer coverage boundary. Edge softening darkens a narrow strip and protects it from sharpening when sent to Processing. It does not fill missing areas or remove every internal seam.")},
            {title: qsTr("Finish once the mosaic is assembled"), body: qsTr("Send the result to Processing for the final wavelets and color adjustments. Add a caption and title at the end. The number of assembled images follows the mosaic into Processing. Exporting and reopening a TIFF does not restore the assembly settings or edge-protection mask.")}
          ], action: qsTr("Go to Mosaic"), tab: "mosaic" },
        { title: qsTr("Export and History"), lead: qsTr("Keep your originals and find your results"),
          intro: qsTr("Capture files and processed exports have separate destination folders in Settings. These choices are saved locally across application updates."),
          cards: [
            {title: qsTr("Save a result"), body: qsTr("Processing and Deep sky offer PNG, TIFF or JPEG with an optional caption; Mosaic exports TIFF. Prefer 16-bit PNG or TIFF for detail and keep the deep-sky Linear FITS for later processing. An imported source is protected from overwriting: choose a different name. The caption preview appears automatically. Edit the pre-filled target, equipment and technical information before saving. Export shows its progress and an estimated file size; PNG/JPEG compression makes the final size variable. Once exported, the caption is part of the image.")},
            {title: qsTr("What appears in History?"), body: qsTr("With automatic history enabled, successful exports from Mosaic and Processing are added, including a mosaic finished in Processing. Capture snapshots are also remembered. Moving between tabs alone does not save an image.")},
            {title: qsTr("Paths, not duplicate files"), body: qsTr("History remembers file locations. Saving again to the same path updates one entry; a new path creates another. You can import existing images, open them or reveal them in Finder. Removing an entry does not delete the image; missing paths are cleaned automatically.")},
            {title: qsTr("Keep enough to start again"), body: qsTr("Keep the SER recordings and the uncaptioned image portions separately from your final exports. A TIFF preserves the image, not an editable project with its frame selection, wavelet settings or assembly history.")}
          ], action: qsTr("Go to History"), tab: "history" }
        ,{title:qsTr("Observation"),lead:qsTr("Find a suitable time before capturing"),
          intro:qsTr("Start by choosing your place and local night. Find a visible object offers suggestions; Study opens the current target. The Selected object label always names the only active target. Observation includes the Moon, planets and fixed catalogue objects, independently of Deep sky."),
          cards:[
            {title:qsTr("Reference time and recording"),body:qsTr("Reference time defaults to At home, using this Mac’s time zone. At the telescope uses the observing site’s configured zone. Expand Reference time to choose the date and enter HH:mm: the cursor and all views follow the same UTC instant. The dates can differ between home and telescope. Chart axes and solar/forecast times stay in telescope time. A nonexistent clock-change hour is refused; a repeated hour offers both offsets. In Night, When to start recording shows the first remaining window after the current real time. Show start places the cursor there. Start is rounded up to a minute and end down; all precise windows remain expandable. This prepares a time to launch recording yourself.")},
            {title:qsTr("Planning or reviewing a night?"),body:qsTr("Current night uses the chosen place’s time zone. An ongoing night after midnight can still be dated yesterday. Planning rejects nights already ended at sunrise; without sunrise, the following local noon is the boundary. To review an old observation, enable Explore past dates in Advanced. Visibility settings and detailed solar, lunar and cloud information expand only when needed.")},
            {title:qsTr("Choose what to observe"),body:qsTr("Suggestions uses your place, local date and minimum height. It compares common objects and your favourites offline, showing actual time windows. Deep sky uses astronomical night (Sun below −18°); Solar System targets use the end of civil twilight (−6°). Explore a suggestion to see its curve. The ranking uses geometric visibility. Loaded cloud forecasts add the predicted cloud range at available hourly instants; they do not guarantee clear sky or account for light pollution.")},
            {title:qsTr("Read the curve and the map"),body:qsTr("Night shows the selected object’s height. Blue intervals meet your height and darkness limits. The time slider updates while you drag, in Night, Sky, World and Clouds. Sky is a compass view: edge is the theoretical horizon (0°), centre is overhead (90°). Its point and direction tell you where to look; the line shows the path over the night. Terrain is not shown. World checks visibility on a regional 6° grid at one UTC instant; clicking preserves this instant and selects a place with UTC as its initial time zone. Solar and lunar details stay in Night and Sky.")},
            {title:qsTr("Understand the limits"),body:qsTr("A target above the horizon can still be too low or in a bright sky. Very dark is suggested for deep sky, twilight for the Moon and planets. The lunar readout gives illuminated fraction, height and angular distance from your target. Cloud forecasts are available in the Clouds view, separately from geometric visibility. Seeing, obstructions, reservations and camera control are not included. Object positions use a flat geometric horizon without refraction. Sunrise and sunset use the upper edge of the Sun with standard atmospheric refraction; actual weather and obstacles can shift them.")},
            {title:qsTr("Check the clouds"),body:qsTr("Clouds loads Open-Meteo's hourly model forecast for your coordinates. Use the time slider to compare cloud coverage with your observing windows. The exact forecast hour, retrieval time and model grid cell are shown. Low, mid and high cloud layers overlap. Forecasts extend at most 16 days; unavailable dates or missing values never mean clear sky. The last valid forecast is kept on failure, marked as old after one hour, and can be refreshed. Once loaded, a change of place or date reuses fresh data or loads the new place's forecast.")},
            {title:qsTr("Your place and its name"),body:qsTr("The first launch starts at central Paris (48.8566° N, 2.3522° E). Later launches restore your last chosen place, without automatic geolocation. Name this place lets you save a label such as Garden or Balcony along with the position and time zone. Map points can be named too. Rename edits that favourite without moving the site. Exact coordinates remain available in Advanced. Changing place keeps the UTC instant shared by every location. Local times and the night date are converted; choosing another night or moving the time cursor changes the instant.")},
            {title:qsTr("Names and favourites"),body:qsTr("Change object opens one list with Catalogue and Favourites. Typing filters the list without changing the active target; choosing a result selects it. The star beside Selected object saves that target. OpenNGC works offline; other fixed names use CDS Sesame. City search uses Open-Meteo / GeoNames. Only the typed name is sent for these searches. Favourite places appear with a star; Advanced accepts exact coordinates. Connection errors preserve previous results. Use Moon and planet entries for moving bodies.")}
          ],action:qsTr("Go to Observation"),tab:"observation"}
        ,{ title:qsTr("Studio navigation"),lead:qsTr("One workspace for each task"),
          intro:qsTr("Home offers Capture, Processing and Deep sky, recent saved projects and SER videos, and work still open in this session."),
          cards:[
            {title:qsTr("Move between workspaces"),body:qsTr("The top tabs stay visible. Switching tabs preserves loaded images, framing and controls, and calculations continue in the background. Click the activity label to return to a running task. During recording, Home, Capture, Observation and Guide remain available; other workspaces are locked.")},
            {title:qsTr("Return to a project"),body:qsTr("Resume returns to the current session. Open reloads a saved deep-sky project: a portable project restores its calculated results immediately; a linked project requires its sources and a new integration. The deep-sky gear offers both save modes and Find moved sources. Settings shows cache and automatic recovery sizes and can free unused project caches.")},
            {title:qsTr("Deep-sky tools on the right"),body:qsTr("Images, Stack and Finish form the bar above the image. Stack contains calibration and integration settings. Finish unlocks after stacking. Its right inspector contains the input histogram and adjustment families; the image stays on the left with zoom below it. The floppy button opens final-image or linear FITS export. The project gear manages projects and finishing presets. In Images and Stack, the folder button toggles the source list.")}
          ],action:qsTr("Go to Home"),tab:"home"}
        ,{title:qsTr("From Siril"),lead:qsTr("Familiar controls, explicit parameters"),
          intro:qsTr("Keep the same workflow: calibrate, register, stack, then finish. The linear FITS keeps the integration; the final image contains your finishing adjustments."),
          cards:[
            {title:qsTr("Resume the calculated results"),body:qsTr("Home offers Restore session after restarting. It restores calculated images, settings, captions and A/B versions. Saving the session before quitting waits for the latest changes. Keep your source files and project as well.")},
            {title:qsTr("Crop and geometry"),body:qsTr("In Finish, choose Geometry. In Processing, choose Crop, rotate and resize. Draw a rectangle, move it or adjust its handles. X and Y start at zero in the top-left corner. Crop and quarter-turns keep pixel values; free rotation and scaling use the selected interpolation.")},
            {title:qsTr("Local masks"),body:qsTr("Advanced transformations offers automatic, painted and imported masks. White applies the treatment, black protects the input, gray blends. Red shows protected areas. Choose the mask scope. Cmd+Z removes a brush stroke while the editor is open. Imported masks must match the recipe input dimensions.")},
            {title:qsTr("Check the parameter units"),body:qsTr("GHS, PSF, Richardson–Lucy, multiscale denoising and SCNR expose parameters and practical help. Values and algorithms are not interchangeable with every Siril tool. Color provides guided TAN or local blind astrometry, SIP distortion fitting and independent Gaia verification. Inspect RMS and matched stars. PCC uses stellar temperature models; SPCC uses measured Gaia XP spectra and your equipment response. Neither promises numerical equivalence with Siril. Keep the linear integration and compare controlled changes.")}
          ],action:qsTr("Go to Deep sky"),tab:"deepSky"}
    ]
    readonly property var lesson: lessons[topic]
    ColumnLayout {
        anchors.top:parent.top;anchors.bottom:parent.bottom;anchors.horizontalCenter:parent.horizontalCenter;anchors.topMargin:20;anchors.bottomMargin:20;width:Math.min(1040,parent.width-40);spacing:16
        Label { text: qsTr("Guide"); color: Atelier.text; font.pixelSize: 20; font.weight:Font.Medium }
        Label { text: qsTr("From the first recording to the finished image, at your own pace."); color: Atelier.muted; wrapMode: Text.WordWrap; Layout.fillWidth: true }
        Flow {
            Layout.fillWidth: true; spacing: 8
            Repeater {
                model: root.lessons
                IconButton {
                    required property int index; required property var modelData
                    text: modelData.title; borderColor: root.topic===index ? Atelier.accent : Atelier.border
                    onClicked: { root.topic=index; lessonScroll.contentItem.contentY=0; }
                }
            }
        }
        ScrollView {
            id: lessonScroll
            objectName: "guideLessonScroll"
            Layout.fillWidth: true; Layout.fillHeight: true
            contentWidth: availableWidth; clip: true
            ScrollBar.vertical.policy: ScrollBar.AsNeeded
            ScrollBar.horizontal.policy: ScrollBar.AlwaysOff
            ColumnLayout {
                width: lessonScroll.availableWidth; spacing: 14
                Label { text: root.lesson.lead; font.pixelSize: 20; color: Atelier.text; wrapMode: Text.WordWrap; Layout.fillWidth: true }
                Label { text: root.lesson.intro; color: Atelier.secondary; wrapMode: Text.WordWrap; Layout.fillWidth: true; bottomPadding: 8 }
                Repeater {
                    model: root.lesson.cards
                    Rectangle {
                        required property var modelData
                        objectName:modelData.title===qsTr("Create calibration masters in batches")?"guideBatchMastersCard":""
                        Layout.fillWidth: true; implicitHeight: cardText.implicitHeight+32
                        color: Atelier.surface; radius: 4; border.color: Atelier.border
                        ColumnLayout {
                            id: cardText
                            anchors.left: parent.left; anchors.right: parent.right; anchors.top: parent.top; anchors.margins: 16; spacing: 8
                            Label { text: modelData.title; font.pixelSize: 16; color: Atelier.text; wrapMode: Text.WordWrap; Layout.fillWidth: true }
                            Label { text: modelData.body; font.pixelSize: 13; color: Atelier.secondary; wrapMode: Text.WordWrap; Layout.fillWidth: true; lineHeight: 1.2 }
                        }
                    }
                }
                IconButton { text: root.lesson.action; enabled: !root.captureActive || root.lesson.tab==="capture"; onClicked: root.navigate(root.lesson.tab) }
                Item { Layout.preferredHeight: 8 }
            }
        }
    }
}
